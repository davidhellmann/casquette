---
import { BASE } from '../components/app/nav';
import '../styles/app.css';
import { Font } from 'astro:assets';
import { AppShell } from '../components/app/AppShell';
import { LANG, pageTitle, t } from '../i18n/index.js';
import { fmtDayMonth, nf } from '../scripts/format.js';
import { isDemo, loadAthlete, loadGear, loadRides, loadStatRides } from '../lib/data.js';
import { legalLinks } from '../lib/legal-links.js';
import { yearTotals } from '../training/index.js';
import type { NavSubmenus } from '../components/app/nav';

/** Setup steps for the first sync (shown while the demo data is active). */
const SETUP_URL = 'https://github.com/davidhellmann/casquette#quick-start';

type Section = 'dashboard' | 'rides' | 'years' | 'map' | 'segments' | 'performance' | 'gear';
interface Props {
  title?: string;
  active?: Section;
  /** Show the period and zone-basis controls in the page header (dashboard, ride log). */
  period?: boolean;
  /** Show the year switch in the page header (year review): this year and all years, newest first. */
  yearSwitch?: { year: number; years: number[] };
}
const { title = '', active = 'dashboard', period = false, yearSwitch } = Astro.props;
const base = BASE;
// og:image needs an absolute URL – with `site` in astro.config.mjs, otherwise relative
const ogImage = Astro.site ? new URL(`${base}og.png`, Astro.site).href : `${base}og.png`;

// Breadcrumbs: the section, plus the page title on detail pages (/rides/<id>, /years/<year> …)
const section = { label: t(`nav.${active}`), href: active === 'dashboard' ? base : `${base}${active}` };
const depth = Astro.url.pathname.slice(base.length).split('/').filter(Boolean).length;
const crumbs = depth > 1 && title ? [section, { label: title }] : [section];

// Hosted demo only: links to the website's legal pages (PUBLIC_LEGAL_URL, website/README.md)
const legal = legalLinks(import.meta.env.PUBLIC_LEGAL_URL) ?? undefined;

const syncedAt = loadAthlete().synced_at;
const lastSync = syncedAt ? fmtDayMonth(new Date(syncedAt), true) : undefined;

// Sidebar submenus: the last 5 rides, the latest 3 years and the active bikes – each with a second line (date, km)
const years = yearTotals(await loadStatRides());
const km = (v: number) => `${nf(v)} km`;
const now = new Date();
const submenus: NavSubmenus = {
  rides: (await loadRides()).filter((r: any) => r.d <= now).slice(0, 5).map((r: any) => ({ href: `${base}rides/${r.id}`, label: r.name, detail: `${fmtDayMonth(r.d)} · ${km(r.distance / 1000)}` })),
  years: years.slice(-3).reverse().map(({ year, km: v }) => ({ href: `${base}years/${year}`, label: String(year), detail: km(v) })),
  gear: (await loadGear()).filter((g: any) => g.type === 'bike' && !g.retired).map((g: any) => ({ href: `${base}gear/${g.id}`, label: g.name, detail: km(g.kmTotal) })),
};
---
<!doctype html>
<html lang={LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="description" content={t('app.description')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('app.name')} />
    <meta property="og:title" content={pageTitle(title)} />
    <meta property="og:description" content={t('app.description')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-damion" preload />
    <title>{pageTitle(title)}</title>
    <script is:inline>
      // Theme before first paint – same logic as src/lib/theme.ts (rc_theme light/dark/auto, light by default)
      (function () {
        try {
          var t = localStorage.getItem('rc_theme');
          if (t === 'auto') t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.classList.toggle('dark', t === 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <AppShell client:load active={active} crumbs={crumbs} period={period} yearSwitch={yearSwitch && { ...yearSwitch, base }} demoHref={isDemo() ? SETUP_URL : undefined} lastSync={lastSync} legal={legal} submenus={submenus} path={Astro.url.pathname}>
      <main id="content" class="min-w-0">
        <div class="mx-auto w-full max-w-[1440px] px-4 pt-2 lg:px-7"><slot /></div>
      </main>
    </AppShell>
  </body>
</html>
