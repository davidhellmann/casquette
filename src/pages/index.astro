---
import Base from '../layouts/Base.astro';
import { DashboardView } from '../components/dashboard/DashboardView';
import { encodeDashboard } from '../lib/dashboard-payload.js';
import { getDataset } from '../lib/data.js';

const data = await getDataset();
const json = encodeDashboard({ rides: data.rides, athlete: data.athlete, athleteState: data.athleteToday, goals: data.goals });
---
<Base active="dashboard" period>
  <DashboardView client:load />
  <script type="application/json" id="dash-data" set:html={json}></script>
</Base>
