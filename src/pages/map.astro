---
import Base from '../layouts/Base.astro';
import { MapView } from '../components/map/MapView';
import { getDataset } from '../lib/data.ts';
import { mapPayload } from '../lib/map-payload.ts';
import { t } from '../i18n/index.ts';

const { props, json } = mapPayload(await getDataset());
---
<Base title={t('map.title')} active="map">
  <MapView client:load {...props} />
  <script type="application/json" id="map-data" set:html={json}></script>
</Base>
