---
import Base from '../../layouts/Base.astro';
import { RidesView } from '../../components/rides/RidesView';
import { encodeDashboard } from '../../lib/dashboard-payload.ts';
import { getDataset } from '../../lib/data.ts';
import { t } from '../../i18n/index.ts';

const data = await getDataset();
const json = encodeDashboard({ rides: data.rides, athlete: data.athlete, athleteState: data.athleteToday });
---
<Base title={t('log.title')} active="rides" period>
  <RidesView client:load />
  <script type="application/json" id="dash-data" set:html={json}></script>
</Base>
