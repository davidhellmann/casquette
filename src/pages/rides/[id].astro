---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { RideView } from '../../components/ride/RideView';
import { getDataset } from '../../lib/data.ts';
import { ridePayload } from '../../lib/ride-payload.ts';
import { t } from '../../i18n/index.ts';

export async function getStaticPaths() {
  return (await getDataset()).rides.map((r) => ({ params: { id: r.id }, props: { id: r.id } }));
}

const { id } = Astro.props;
const data = await getDataset();
const R = ridePayload(data, { id });
const entry = data.entry('rides', id);
const { Content } = await render(entry);
const raw = JSON.stringify(entry.data, null, 2);
const hasDescription = !!entry.body?.trim();
---
<Base title={R.name} active="rides">
  <RideView client:load R={R} />
  <section class="grid gap-3 pb-8 lg:grid-cols-2" aria-labelledby="ride-notes">
    <h2 id="ride-notes" class="sr-only">{t('ride.notes')}</h2>
    <div data-slot="card" class="flex min-w-0 flex-col gap-4 rounded-lg bg-card py-5 text-card-foreground">
      <div class="px-5">
        <h3 class="w-fit rounded-sm bg-brand-surface px-1.5 py-0.5 font-mono text-[10.5px] font-medium tracking-[0.08em] text-brand-surface-foreground uppercase">{t('ride.description')}</h3>
      </div>
      <div class="px-5 text-sm leading-relaxed [&_a]:underline [&_p]:mb-2 [&_p:last-child]:mb-0" data-testid="ride-description">
        {hasDescription ? <Content /> : <p class="text-muted-foreground">{t('ride.noDescription')}</p>}
      </div>
    </div>
    <div data-slot="card" class="flex min-w-0 flex-col gap-4 rounded-lg bg-card py-5 text-card-foreground">
      <div class="px-5">
        <h3 class="w-fit rounded-sm bg-brand-surface px-1.5 py-0.5 font-mono text-[10.5px] font-medium tracking-[0.08em] text-brand-surface-foreground uppercase">{t('ride.allData')}</h3>
      </div>
      <details class="group px-5 text-sm">
        <summary class="w-fit cursor-pointer rounded-sm text-muted-foreground hover:text-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none">{t('ride.showRaw')}</summary>
        <pre class="mt-3 max-h-[480px] overflow-auto rounded-md bg-background p-3 font-mono text-xs leading-relaxed" tabindex="0" data-testid="ride-raw">{raw}</pre>
      </details>
    </div>
  </section>
</Base>
