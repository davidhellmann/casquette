---
import Base from '../../layouts/Base.astro';
import { SegmentsView } from '../../components/segments/SegmentsView';
import { getDataset } from '../../lib/data.js';
import { segmentsIndexPayload } from '../../lib/segment-payload.ts';
import { t } from '../../i18n/index.js';

const payload = segmentsIndexPayload(await getDataset());
---
<Base title={t('segments.title')} active="segments">
  <SegmentsView client:load P={payload} />
</Base>
