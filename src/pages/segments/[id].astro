---
import type { InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import { SegmentView } from '../../components/segments/SegmentView';
import { getDataset } from '../../lib/data.ts';
import { segmentPageIds, segmentPayload } from '../../lib/segment-payload.ts';

export async function getStaticPaths() {
  return segmentPageIds(await getDataset()).map((id) => ({ params: { id }, props: { id } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { id } = Astro.props;
const payload = segmentPayload(await getDataset(), { id });
---
<Base title={payload.name} active="segments">
  <SegmentView client:load S={payload} />
</Base>
