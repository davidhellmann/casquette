---
import Base from '../../layouts/Base.astro';
import { YearView } from '../../components/years/YearView';
import { getDataset } from '../../lib/data.ts';
import { yearList } from '../../lib/years.ts';
import { yearPayload } from '../../lib/year-payload.ts';

export async function getStaticPaths() {
  const years = yearList(await getDataset());
  return years.map((y) => ({ params: { year: String(y) }, props: { year: y, years } }));
}
const { year, years } = Astro.props;
const payload = yearPayload(await getDataset(), { year });
---
<Base title={`${year}`} active="years" yearSwitch={{ year, years }}>
  <YearView client:load P={payload} />
</Base>
