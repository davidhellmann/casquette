---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { GearDetailView } from '../../components/gear/GearDetailView';
import { getDataset } from '../../lib/data.js';
import { gearPayload } from '../../lib/gear-payload.ts';

export async function getStaticPaths() {
  return (await getDataset()).gear.map((g) => ({ params: { id: g.id }, props: { id: g.id } }));
}

const { id } = Astro.props;
const data = await getDataset();
const payload = gearPayload(data, { id });
const entry = data.entry('gear', id);
const Content = entry ? (await render(entry)).Content : null;
---
<Base title={payload.name} active="gear">
  <GearDetailView client:load P={payload}>{Content && <Content />}</GearDetailView>
</Base>
