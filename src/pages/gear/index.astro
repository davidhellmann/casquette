---
import Base from '../../layouts/Base.astro';
import { GearView } from '../../components/gear/GearView';
import { getDataset } from '../../lib/data.js';
import { gearIndexPayload } from '../../lib/gear-payload.ts';
import { t } from '../../i18n/index.js';

const payload = gearIndexPayload(await getDataset());
---
<Base title={t('gear.title')} active="gear">
  <GearView client:load P={payload} />
</Base>
