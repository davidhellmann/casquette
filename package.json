{
  "name": "casquette",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Casquette – a personal, fully static training dashboard for your Strava rides, built with Astro",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "astro check",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:website": "playwright test -c playwright.website.config.ts",
    "strava:auth": "node scripts/sync/strava-auth.ts",
    "sync": "node scripts/sync/strava-sync.ts",
    "sync:all": "node scripts/sync/strava-sync.ts --wait",
    "sync:rebuild": "node scripts/sync/strava-rebuild.ts",
    "geo": "node --env-file-if-exists=.env scripts/sync/geo.ts",
    "demo:generate": "node scripts/site/generate-demo.ts",
    "demo:fetch-routes": "node scripts/site/fetch-demo-routes.ts",
    "demo:check": "node scripts/site/check-demo-build.ts",
    "screenshots": "node scripts/site/screenshots.ts",
    "fragments": "node scripts/site/fragments.ts",
    "brand": "node scripts/site/brand.ts",
    "og": "node scripts/site/og.ts",
    "site:build": "node scripts/site/site-build.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "astro": "^7.3.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/damion": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
