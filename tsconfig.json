{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "dist-*", "public/streams", "website", "test-results", "playwright-report", ".scratch", "logs"],
  "compilerOptions": {
    // Node runs scripts/ directly (type stripping, docs/adr/0004): only syntax it can erase, explicit .ts imports
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noUncheckedSideEffectImports": true,
    // Everything is TypeScript (docs/adr/0004); website/ stays plain JS and is excluded
    "allowJs": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  }
}
