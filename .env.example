# Strava API app – create one at https://www.strava.com/settings/api
# Set its "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional: fallbacks in case Strava provides no values
# FTP=200
# WEIGHT=90

# Optional: language of place names from reverse geocoding (default: en)
# Keep it stable once src/data/geo-cells.json is filled, otherwise place names mix languages.
# GEO_LANG=en
